<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tom.auriga-gcal</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/tom/auriga-gcal/run_sync.sh</string>
    </array>

    <!-- Checkpoints through the day. Each one is a near-no-op if a sync
         already succeeded within REFRESH_STALE_AFTER_HOURS (config.py) --
         run_sync.sh checks staleness.py before doing anything real. This
         settles into ~2 real refreshes/day without needing to know when
         you actually have class, and catches up quickly at the next
         checkpoint if the Mac was asleep or a run failed. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>30</integer></dict>
    </array>

    <!-- if the Mac was asleep at the scheduled time, run once on wake -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/tom/auriga-gcal/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/tom/auriga-gcal/launchd.log</string>
</dict>
</plist>
