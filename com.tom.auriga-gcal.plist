<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tom.auriga-gcal</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/tom/auriga-gcal/run_sync.sh</string>
    </array>

    <!-- run at 07:00 and 19:00 every day -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <!-- if the Mac was asleep at the scheduled time, run once on wake -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/tom/auriga-gcal/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/tom/auriga-gcal/launchd.log</string>
</dict>
</plist>
